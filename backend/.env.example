# Gig backend — copy to .env and fill in.
# Everything runs with sane defaults except the database; see ../databases.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production

# PostgreSQL (matches databases/docker-compose.yml)
DATABASE_URL="postgresql://gig:gig_dev_password@localhost:5433/gig_db?schema=public"

# Redis (matches databases/docker-compose.yml)
REDIS_URL=redis://localhost:6380

# ------------------------------------------------------------------
# OTP SMS delivery. Unset => the code is logged to the console and
# returned to the client in non-production mode (visible in the UI
# banner) so the flow is testable end-to-end without an SMS vendor.
# ------------------------------------------------------------------
# SMS_PROVIDER_API_KEY=your-provider-key

# ------------------------------------------------------------------
# Google Calendar (ITR deadline reminders).
# 1. console.cloud.google.com -> new project -> enable Google Calendar API
# 2. OAuth consent screen -> External -> add yourself as a test user
# 3. Credentials -> OAuth client ID -> Web application
#    redirect URI: http://localhost:4000/api/calendar/callback
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/callback

# ------------------------------------------------------------------
# Gemini AI assistant (dashboard chatbot).
# Get a key at https://aistudio.google.com/apikey
# ------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------
# IRIS IRP / IRIS GST (e-invoice IRN + GSTR APIs).
# Sandbox credentials from developer.irisirp.com / developer.irisgst.com
# Unset => the GST desk runs in simulation mode: requests are validated,
# a realistic payload is built, and a synthetic IRN is returned.
# ------------------------------------------------------------------
IRIS_CLIENT_ID=
IRIS_CLIENT_SECRET=
IRIS_USERNAME=
IRIS_PASSWORD=
IRIS_BASE_URL=https://developer.irisirp.com
